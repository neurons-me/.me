{"id": "e01", "lang": "en", "text": "Luis is 30 years old", "state": {"luis": {"name": "Luis"}}, "expected_ops": [{"op": "set", "path": "luis.age", "value": 30}]}
{"id": "e02", "lang": "es", "text": "Ana ahora vive en Monterrey", "state": {"ana": {"city": "Madrid"}}, "expected_ops": [{"op": "set", "path": "ana.city", "value": "Monterrey"}]}
{"id": "e03", "lang": "en", "text": "set the shop tax rate to 0.16", "state": {"shop": {"name": "Coffee"}}, "expected_ops": [{"op": "set", "path": "shop.tax_rate", "value": 0.16}]}
{"id": "e04", "lang": "es", "text": "el stock del inventario es 900 unidades", "state": {"inventory": {}}, "expected_ops": [{"op": "set", "path": "inventory.stock", "value": 900}]}
{"id": "e05", "lang": "en", "text": "the first product is a Keyboard that costs 80", "state": {"products": {}}, "expected_ops": [{"op": "set", "path": "products[1].name", "value": "Keyboard"}, {"op": "set", "path": "products[1].price", "value": 80}]}
{"id": "e06", "lang": "es", "text": "el total de la orden es el subtotal más el impuesto", "state": {"orden": {"subtotal": 200, "impuesto": 32}}, "expected_ops": [{"op": "define", "path": "orden", "name": "total", "expr": "subtotal + impuesto"}]}
{"id": "e07", "lang": "en", "text": "each item's total is price plus price times the shop tax rate", "state": {"shop": {"tax_rate": 0.16, "items": {"1": {"price": 100}, "2": {"price": 50}}}}, "expected_ops": [{"op": "define", "path": "shop.items[i]", "name": "total", "expr": "price + (price * shop.tax_rate)"}]}
{"id": "e08", "lang": "es", "text": "la ganancia es ventas menos costos", "state": {"negocio": {"ventas": 1000, "costos": 600}}, "expected_ops": [{"op": "define", "path": "negocio", "name": "ganancia", "expr": "ventas - costos"}]}
{"id": "e09", "lang": "en", "text": "a user is an adult when age is at least 18", "state": {"user": {"age": 22}}, "expected_ops": [{"op": "define", "path": "user", "name": "isAdult", "expr": "age >= 18"}]}
{"id": "e10", "lang": "es", "text": "haz que el perfil público apunte a los datos de Ana", "state": {"ana": {"city": "Madrid", "age": 22}}, "expected_ops": [{"op": "pointer", "path": "profile.public", "target": "ana"}]}
{"id": "e11", "lang": "en", "text": "link my current car to the tesla", "state": {"cars": {"tesla": {"model": "3"}}}, "expected_ops": [{"op": "pointer", "path": "me.car", "target": "cars.tesla"}]}
{"id": "e12", "lang": "es", "text": "elimina la ciudad de Ana", "state": {"ana": {"city": "Madrid", "age": 22}}, "expected_ops": [{"op": "remove", "path": "ana", "key": "city"}]}
{"id": "e13", "lang": "en", "text": "delete the temp value", "state": {"temp": {"value": "x"}}, "expected_ops": [{"op": "remove", "path": "temp", "key": "value"}]}
{"id": "e14", "lang": "es", "text": "mi salud es privada, mi tipo de sangre es O+", "state": {}, "expected_ops": [{"op": "secret", "path": "salud"}, {"op": "set", "path": "salud.tipo_sangre", "value": "O+"}]}
{"id": "e15", "lang": "en", "text": "make my wallet secret with the key abc123", "state": {"wallet": {"balance": 10}}, "expected_ops": [{"op": "secret", "path": "wallet"}]}
{"id": "e16", "lang": "es", "text": "reinicia el ruido de la billetera", "state": {"billetera": {"saldo": 5}}, "expected_ops": [{"op": "noise", "path": "billetera"}]}
{"id": "e17", "lang": "en", "text": "I am @abella", "state": {}, "expected_ops": [{"op": "identity", "handle": "abella"}]}
{"id": "e18", "lang": "es", "text": "¿cuántos años tiene Luis?", "state": {"luis": {"age": 30}}, "expected_ops": [{"op": "query", "paths": ["luis.age"]}]}
{"id": "e19", "lang": "en", "text": "show me the shop tax rate and name", "state": {"shop": {"tax_rate": 0.16, "name": "Coffee"}}, "expected_ops": [{"op": "query", "paths": ["shop.tax_rate", "shop.name"]}]}
{"id": "e20", "lang": "es", "text": "Ana pagó 450 del taxi para ella y Luis", "state": {"split": {"members": ["Sui", "Ana", "Luis"]}}, "expected_ops": [{"op": "set", "path": "split.expenses[1].title", "value": "taxi"}, {"op": "set", "path": "split.expenses[1].payer", "value": "Ana"}, {"op": "set", "path": "split.expenses[1].amount", "value": 450}, {"op": "set", "path": "split.expenses[1].participants", "value": ["Ana", "Luis"]}], "speaker": "Sui"}
{"id": "e21", "lang": "en", "text": "Luis paid 90 for coffee for everyone", "state": {"split": {"members": ["Sui", "Ana", "Luis"]}}, "expected_ops": [{"op": "set", "path": "split.expenses[1].title", "value": "coffee"}, {"op": "set", "path": "split.expenses[1].payer", "value": "Luis"}, {"op": "set", "path": "split.expenses[1].amount", "value": 90}, {"op": "set", "path": "split.expenses[1].participants", "value": ["Sui", "Ana", "Luis"]}], "speaker": "Sui"}
{"id": "e22", "lang": "es", "text": "Luis tiene 30 y Ana tiene 22", "state": {"luis": {}, "ana": {}}, "expected_ops": [{"op": "set", "path": "luis.age", "value": 30}, {"op": "set", "path": "ana.age", "value": 22}]}
{"id": "e23", "lang": "en", "text": "rename the shop to Bean There and remove its tax rate", "state": {"shop": {"name": "Coffee", "tax_rate": 0.16}}, "expected_ops": [{"op": "set", "path": "shop.name", "value": "Bean There"}, {"op": "remove", "path": "shop", "key": "tax_rate"}]}
{"id": "e24", "lang": "es", "text": "cambia el precio del pan a 25 y que el total del menú sea café más pan", "state": {"menu": {"cafe": {"precio": 45}, "pan": {"precio": 20}}}, "expected_ops": [{"op": "set", "path": "menu.pan.precio", "value": 25}, {"op": "define", "path": "menu", "name": "total", "expr": "cafe.precio + pan.precio"}]}
{"id": "e25", "lang": "en", "text": "Ana's email is ana@example.com", "state": {"ana": {"age": 22}}, "expected_ops": [{"op": "set", "path": "ana.email", "value": "ana@example.com"}]}
{"id": "e26", "lang": "es", "text": "el usuario está activo", "state": {"user": {"name": "Ana"}}, "expected_ops": [{"op": "set", "path": "user.active", "value": true}]}
{"id": "e27", "lang": "en", "text": "Ana's friends are Luis and Sui", "state": {"ana": {"age": 22}}, "expected_ops": [{"op": "set", "path": "ana.friends", "value": ["Luis", "Sui"]}]}
{"id": "e28", "lang": "es", "text": "mis contraseñas son privadas", "state": {}, "expected_ops": [{"op": "secret", "path": "contrasenas"}]}
{"id": "e29", "lang": "en", "text": "what's the weather tomorrow in Paris?", "state": {}, "expected_ops": []}
{"id": "e30", "lang": "es", "text": "el descuento es el 10 por ciento del subtotal", "state": {"orden": {"subtotal": 200}}, "expected_ops": [{"op": "define", "path": "orden", "name": "descuento", "expr": "subtotal * 0.1"}]}
